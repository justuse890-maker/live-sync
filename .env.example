# Public OAuth client ID used to request a Google ID token on Android.
# Create a Web application OAuth client in Google Cloud, then add the Android
# package name (com.livesync.ai) and the signing SHA-1 certificate to Google.
VITE_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Investor demo builds use .env.investor-demo. Its login is deliberately
# public and must point only to a sample-data account.
