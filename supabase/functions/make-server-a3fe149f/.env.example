# Server-side configuration for the make-server-a3fe149f edge function.
# Set with `supabase secrets set NAME=value` - never commit real values and never expose these to the client.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# Comma-separated origins allowed by CORS (defaults cover localhost, capacitor://localhost, livesync.app)
ALLOWED_ORIGINS=
# Comma-separated admin emails. Admin access also requires a CONFIRMED email on the auth user.
ADMIN_EMAILS=
# Comma-separated emails that /me/delete must refuse (e.g. the shared investor-demo account)
PROTECTED_ACCOUNT_EMAILS=
# (No AI keys here: LiveSync runs no AI service. Users connect their own provider in the app.)
# Leave unset in production. "true" lets any signed-in user self-assign Pro/Lifetime without paying
# (the legacy "payments in sandbox mode" behaviour). Remove once a payment provider is integrated.
ALLOW_UNPAID_UPGRADES=
